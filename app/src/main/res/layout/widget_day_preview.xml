<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
            android:textStyle="bold"
        android:text="Aujourd\'hui"
        android:textColor="@color/text"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="8h00" android:textColor="@color/text" android:textSize="14sp" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_tile" android:tint="#FDE6DF" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_maths" android:tint="#B2503C" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="B204" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Mathématiques" android:textColor="@color/text2" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="9h00" android:textColor="@color/text" android:textSize="14sp" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_tile" android:tint="#FCE6EF" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_language" android:tint="#B0406F" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="C102" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Anglais LV1" android:textColor="@color/text2" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill_alert" android:fontFamily="sans-serif-medium" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="Prof absent" android:textColor="@color/alert" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="10h10" android:textColor="@color/text" android:textSize="14sp" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_tile" android:tint="#E1F0FA" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_flask" android:tint="#2F73A3" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="Labo 2" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Physique-chimie" android:textColor="@color/text2" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="11h05" android:textColor="@color/text" android:textSize="14sp" />
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_tile" android:tint="#FDEEDD" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_world" android:tint="#A8681A" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif"
            android:textStyle="bold" android:text="A001" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Histoire-géo" android:textColor="@color/text2" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
