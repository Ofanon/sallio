<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the certificates shipped with Android: a certificate
     installed by someone else (proxy, spyware) cannot read the traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
