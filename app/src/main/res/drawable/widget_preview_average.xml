    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#D49A1C" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD66B" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
