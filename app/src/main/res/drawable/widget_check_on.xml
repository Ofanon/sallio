<?xml version="1.0" encoding="utf-8"?>
<!-- Ticked homework box on a widget: accent square, white check. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_check" android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp" />
</layer-list>
